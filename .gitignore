!templates/**/.workflour/
!templates/**/.workflour/**

# Live deployments and session evidence: curated documentation is in docs/
/projects/
/records/
/tests/evidence/
/integrations/openmausbot/team-v2/deployment.json
/integrations/openmausbot/team-v2/LEGACY-HANDOFF.json
